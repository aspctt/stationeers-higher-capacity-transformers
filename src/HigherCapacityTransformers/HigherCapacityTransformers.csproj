<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>HigherCapacityTransformers</AssemblyName>
		<RootNamespace>HigherCapacityTransformers</RootNamespace>
		<!-- Stationeers runs the mod on Unity's Mono, which loads .NET Framework 4.7.2 assemblies. -->
		<TargetFramework>net472</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<ImplicitUsings>disable</ImplicitUsings>
		<!-- Properties\AssemblyInfo.cs already declares these, and generating them as well fails the build on duplicates. -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Deterministic>true</Deterministic>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>

		<!-- Compiled DLL drops straight into the mod folder, which ships as is. -->
		<OutputPath>..\..\Mod\</OutputPath>
		<!-- Don't drag Stationeers/Unity/BepInEx DLLs into the mod folder. -->
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<!--
		Path to the Stationeers install, with BepInEx in it. Defaults point at this
		machine's install; override on the command line with:
			dotnet build -p:StationeersDir=...
	-->
	<PropertyGroup>
		<StationeersDir Condition="'$(StationeersDir)' == ''">D:\SteamLibrary\steamapps\common\Stationeers</StationeersDir>
		<StationeersManagedDir>$(StationeersDir)\rocketstation_Data\Managed</StationeersManagedDir>
		<BepInExCoreDir>$(StationeersDir)\BepInEx\core</BepInExCoreDir>
	</PropertyGroup>

	<ItemGroup>
		<!-- net472 reference assemblies without needing Visual Studio installed. -->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<!--
		Private=false on every reference: the game and BepInEx already provide these at
		runtime, and copying them into Mod\ would ship their DLLs with the mod.
	-->
	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(StationeersManagedDir)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(StationeersManagedDir)\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(StationeersManagedDir)\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="BepInEx">
			<HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<!-- HarmonyX, the Harmony fork that ships with BepInEx 5. -->
		<Reference Include="0Harmony">
			<HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
